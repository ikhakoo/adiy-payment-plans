// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum PlanSource {
  STOREFRONT
  REP
}

enum PlanStatus {
  ACTIVE // charging on schedule
  PAST_DUE // an installment failed and is being retried
  PAUSED // staff paused charging
  COMPLETED // outstanding balance reached zero, fulfillment released
  CANCELLED // order cancelled / plan stopped by staff
  DEFAULTED // retries exhausted, needs a human decision
}

enum InstallmentStatus {
  SCHEDULED
  PROCESSING // charge sent to Shopify, waiting on the async result
  PAID
  FAILED // last attempt failed; nextAttemptAt says when we retry
  SKIPPED
  WAIVED
}

// One payment plan per original order. Amounts are merchandise before tax and shipping:
// `total` is the full price, `paid`/`outstanding` move as each monthly billing succeeds.
model PaymentPlan {
  id                String     @id @default(cuid())
  shop              String
  orderId           String     @unique // gid://shopify/Order/…
  orderName         String // "#1234"
  customerId        String?
  customerEmail     String?
  customerName      String?
  contractId        String?    @unique // gid://shopify/SubscriptionContract/… — what we bill
  sellingPlanId     String?
  source            PlanSource @default(STOREFRONT)
  repStaffId        String?
  installmentsCount Int
  intervalMonths    Int        @default(1)
  currency          String     @default("USD")
  total             Decimal    @db.Decimal(12, 2)
  paid              Decimal    @db.Decimal(12, 2)
  outstanding       Decimal    @db.Decimal(12, 2)
  status            PlanStatus @default(ACTIVE)
  fulfillmentHeld   Boolean    @default(false)
  termsVersion      String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  completedAt       DateTime?

  installments Installment[]
  events       AuditEvent[]

  @@index([shop, status])
}

model Installment {
  id               String            @id @default(cuid())
  planId           String
  plan             PaymentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  seq              Int // 1 = the checkout payment
  dueDate          DateTime
  amount           Decimal           @db.Decimal(12, 2)
  status           InstallmentStatus @default(SCHEDULED)
  attempts         Int               @default(0)
  nextAttemptAt    DateTime?
  lastError        String?
  billingAttemptId String?
  // Changes on every attempt (planId:seq:attempt) so a retry is a new charge, while a
  // crash-and-resend of the *same* attempt is deduplicated by Shopify.
  idempotencyKey   String?
  chargeOrderId    String? // the order Shopify created for this payment (seq 1 = the original order)
  chargeOrderName  String?
  paidAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([planId, seq])
  @@index([status, dueDate])
}

model AuditEvent {
  id        String      @id @default(cuid())
  planId    String
  plan      PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  type      String // plan_created, charge_started, charge_succeeded, charge_failed, rescheduled, …
  actor     String      @default("system") // "system" or a staff member id/email
  message   String?
  data      Json?
  createdAt DateTime    @default(now())

  @@index([planId, createdAt])
}

// Per-shop business rules. Defaults are placeholders until the business-rules doc is signed off.
model Settings {
  shop                 String   @id
  // Days after each failed attempt to retry. Once they run out the plan is DEFAULTED.
  retryDays            Int[]    @default([3, 7])
  reminderLeadDays     Int      @default(3)
  sellingPlanGroupId   String?
  // Hidden "Payment plan installment" product that monthly payments are billed for.
  installmentProductId String?
  installmentVariantId String?
  // { "gid://shopify/SellingPlan/…": 4, … } — how many installments each selling plan means
  planCounts           Json?
  // Pay in full discount (one-time purchases of plan products): "none" | "percent" | "amount"
  payInFullType        String   @default("none")
  payInFullValue       Decimal? @db.Decimal(12, 2)
  payInFullDiscountId  String? // gid://shopify/DiscountAutomaticNode/…
  updatedAt            DateTime @updatedAt
}

// ------------------------------------------------------------------ rewards portal

// Rewards-portal settings that aren't per reward type.
model RewardSettings {
  shop                    String   @id
  perOrderCap             Decimal  @default(300) @db.Decimal(12, 2) // max reward total per order
  eligibleDays            Int      @default(21) // fulfilled this many days ago counts as delivered
  holdDays                Int      @default(7) // approved rewards stay pending this long
  minCashout              Decimal  @default(25) @db.Decimal(12, 2)
  referralFriendAmount    Decimal  @default(300) @db.Decimal(12, 2) // $ off the friend's first order
  referralReward          Decimal  @default(300) @db.Decimal(12, 2) // credited to the referrer
  referralMinOrder        Decimal  @default(2000) @db.Decimal(12, 2)
  referralWaitDays        Int      @default(30) // after delivery, before the referrer is credited
  referralCodeDays        Int      @default(60) // friend's code expires after this
  // Products the friend's discount applies to (deck kits). Used instead of the minimum order,
  // because on payment plans checkout's subtotal is only the first payment.
  referralCollectionId    String?
  referralCollectionTitle String?
  agreementText           String? // content-use agreement shown with every submission
  agreementVersion        Int      @default(0) // bumped whenever agreementText changes
  // Soft launch: while off, only these customer emails can use the portal.
  portalEnabled           Boolean  @default(false)
  testerEmails            String[] @default([])
  updatedAt               DateTime @updatedAt
}

enum RewardMedia {
  VIDEO
  PHOTO
  ANY
}

// Editable list of things customers can submit (e.g. "Full video walkthrough — $200").
model RewardType {
  id            String       @id @default(cuid())
  shop          String
  name          String
  description   String // shown to customers: what we're looking for
  media         RewardMedia  @default(ANY)
  minAmount     Decimal      @db.Decimal(12, 2)
  maxAmount     Decimal      @db.Decimal(12, 2) // equal to minAmount for a fixed reward
  perOrderLimit Int          @default(1)
  active        Boolean      @default(true)
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  submissions   Submission[]

  @@index([shop, active, position])
}

enum SubmissionStatus {
  DRAFT // created, files uploading, not sent for review yet
  PENDING // waiting for staff
  NEEDS_CHANGES // staff asked for more/different content
  APPROVED
  REJECTED
}

model Submission {
  id               String            @id @default(cuid())
  shop             String
  customerId       String // gid://shopify/Customer/…
  customerName     String?
  customerEmail    String?
  orderId          String // gid://shopify/Order/…
  orderName        String
  rewardTypeId     String
  rewardType       RewardType        @relation(fields: [rewardTypeId], references: [id])
  status           SubmissionStatus  @default(DRAFT)
  note             String?
  agreementVersion Int?
  agreedAt         DateTime?
  driveFolderId    String?
  amount           Decimal?          @db.Decimal(12, 2) // set on approval
  reviewMessage    String? // needs-changes / rejection message shown to the customer
  reviewedBy       String?
  reviewedAt       DateTime?
  submittedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  files            SubmissionFile[]
  events           SubmissionEvent[]

  @@index([shop, status, submittedAt])
  @@index([shop, customerId])
  @@index([orderId, rewardTypeId])
}

model SubmissionFile {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String
  mimeType     String
  size         BigInt
  status       String     @default("UPLOADING") // UPLOADING | UPLOADED | REMOVED
  driveFileId  String?
  createdAt    DateTime   @default(now())
  uploadedAt   DateTime?

  @@index([submissionId, status])
}

model SubmissionEvent {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  type         String // created, submitted, approved, needs_changes, rejected, file_uploaded, …
  actor        String     @default("customer") // "customer", "system" or a staff id
  message      String?
  createdAt    DateTime   @default(now())

  @@index([submissionId, createdAt])
}

// The Google account connected via "Connect Google Drive" and the Shared Drive uploads go to.
model GoogleConnection {
  shop             String   @id
  email            String
  refreshToken     String // AES-GCM encrypted (see app/lib/crypto.server.ts)
  sharedDriveId    String?
  sharedDriveName  String?
  approvedFolderId String? // "Approved" folder at the drive root
  connectedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ------------------------------------------------------------------ rewards ledger

enum CreditSource {
  SUBMISSION
  REFERRAL
  ADJUSTMENT
}

// Money a customer has earned. Pending until availableAt (the hold), then spendable.
model RewardCredit {
  id            String       @id @default(cuid())
  shop          String
  customerId    String
  customerName  String?
  customerEmail String?
  source        CreditSource
  submissionId  String?      @unique
  orderId       String? // the order it was earned on (refund/cancel reverses it during the hold)
  description   String
  amount        Decimal      @db.Decimal(12, 2)
  availableAt   DateTime
  cancelledAt   DateTime?
  cancelReason  String?
  createdBy     String       @default("system")
  createdAt     DateTime     @default(now())

  @@index([shop, customerId])
  @@index([shop, orderId])
}

enum CashoutStatus {
  REQUESTED // balance reserved, waiting for staff to buy the Amazon eGift card
  SENT
  CANCELLED // returned to the balance
}

model Cashout {
  id             String        @id @default(cuid())
  shop           String
  customerId     String
  customerName   String?
  email          String // where the Amazon eGift card is sent
  amount         Decimal       @db.Decimal(12, 2)
  status         CashoutStatus @default(REQUESTED)
  requestedAt    DateTime      @default(now())
  sentAt         DateTime?
  amazonOrderRef String?
  cancelReason   String?
  handledBy      String?

  @@index([shop, status, requestedAt])
  @@index([shop, customerId])
}

// ------------------------------------------------------------------ referrals

// A customer's shareable referral link code (a-diy.com/apps/rewards/r/<code>).
model ReferrerCode {
  id            String     @id @default(cuid())
  shop          String
  customerId    String
  customerName  String?
  customerEmail String?
  code          String     @unique
  createdAt     DateTime   @default(now())
  referrals     Referral[]

  @@unique([shop, customerId])
}

enum ReferralStatus {
  ISSUED // friend claimed a one-time code, hasn't ordered yet
  ORDERED // friend's order used the code; waiting for delivery + wait period
  QUALIFIED // referrer credited
  FLAGGED // failed a fraud check; staff decide
  REJECTED // order cancelled/refunded, or staff rejected
  EXPIRED // code expired unused
}

// One friend claiming one referrer's offer: a single-use discount code tied to their email.
model Referral {
  id                 String         @id @default(cuid())
  shop               String
  referrerCodeId     String
  referrerCode       ReferrerCode   @relation(fields: [referrerCodeId], references: [id])
  referrerCustomerId String
  friendEmail        String
  friendCustomerId   String
  discountCode       String         @unique
  discountId         String
  status             ReferralStatus @default(ISSUED)
  orderId            String?
  orderName          String?
  orderedAt          DateTime?
  qualifiesAt        DateTime?
  creditId           String?
  flagReason         String?
  rejectReason       String?
  expiresAt          DateTime
  handledBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([shop, status])
  @@index([shop, referrerCustomerId])
  @@index([shop, friendEmail])
}
